<Window x:Class="WFix.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:vm="clr-namespace:WFix.App.ViewModels"
        xmlns:conv="clr-namespace:WFix.App.Converters"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="W-Fix — Диагностика и исправление принтеров"
        Width="1340" Height="820"
        MinWidth="1000" MinHeight="600"
        Background="#0D1117"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <conv:LogLevelToColorConverter x:Key="LogColor"/>
        <conv:PrinterStatusToColorConverter x:Key="StatusColor"/>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>   <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Content -->
            <RowDefinition Height="28"/>   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ===== HEADER ===== -->
        <Border Grid.Row="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Логотип -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="🖨" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="W-Fix" FontSize="18" FontWeight="Bold" Foreground="#2D7FF9" VerticalAlignment="Center"/>
                    <TextBlock Text=" | Printer Troubleshooter" FontSize="13" Foreground="#6E7681" VerticalAlignment="Center"/>
                    <Border Background="#1F2937" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v3.1 beta" FontSize="10" Foreground="#58A6FF" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <!-- Действия хедера -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AdStatusText}" Foreground="#58A6FF" VerticalAlignment="Center" FontSize="12"/>
                    <Button Content="🌐 Remote Center" Click="OpenRemoteCenter_Click"
                            ToolTip="Пакетная диагностика и ремонт удалённых компьютеров"
                            Style="{StaticResource FixButton}" Padding="10,6" Margin="8,0,0,0"/>
                    <Button Content="🔗 Pair Repair" Click="OpenPairRepair_Click"
                            ToolTip="Ремонт общего принтера между двумя ПК"
                            Style="{StaticResource FixButton}" Padding="10,6" Margin="8,0,0,0"/>
                    <Button Content="📝 Логи" Command="{Binding OpenLogsFolderCommand}" ToolTip="Открыть папку с текстовыми логами"
                            Style="{StaticResource FixButton}" Padding="10,6" Margin="8,0,0,0"/>
                    <Button Content="↩ Откат" Command="{Binding RestoreLastBackupCommand}"
                            ToolTip="Восстановить состояние до последнего исправления"
                            Style="{StaticResource FixButton}" Padding="10,6" Margin="8,0,0,0"/>
                    <Button Content="🔄 Обновить" Command="{Binding RefreshPrintersCommand}"
                            Style="{StaticResource FixButton}" Padding="10,6" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== MAIN CONTENT (3 columns) ===== -->
        <Grid Grid.Row="1" Margin="8,8,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>   <!-- Printer list -->
                <ColumnDefinition Width="8"/>     <!-- Splitter -->
                <ColumnDefinition Width="*"/>     <!-- Details + Log -->
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="310"/>   <!-- Fix panel -->
            </Grid.ColumnDefinitions>

            <!-- ── LEFT PANEL: Printer List ── -->
            <Border Grid.Column="0" Style="{StaticResource CardPanel}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header printer panel -->
                    <Border Grid.Row="0" Background="#161B22" Padding="12,10" CornerRadius="10,10,0,0">
                        <StackPanel>
                            <TextBlock Text="🖨 Принтеры" FontWeight="SemiBold" Foreground="#E6EDF3"/>
                            <TextBlock Text="{Binding Printers.Count, StringFormat='{}{0} принтеров'}"
                                       Foreground="#6E7681" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Printer ListBox -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding Printers}"
                             SelectedItem="{Binding SelectedPrinter}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,8" Margin="2,2,2,0" CornerRadius="6"
                                        Background="#1C2433">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,7,0"
                                                     Fill="{Binding Status, Converter={StaticResource StatusColor}}"/>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       Foreground="#E6EDF3" TextWrapping="Wrap"
                                                       MaxWidth="210"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding StatusDisplay}" Foreground="#6E7681"
                                                   FontSize="11" Margin="15,2,0,0"/>
                                        <TextBlock Text="{Binding DriverName}" Foreground="#484F58"
                                                   FontSize="10" Margin="15,1,0,0" TextWrapping="Wrap"
                                                   MaxWidth="210"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- Remote machine selector -->
                    <Border Grid.Row="2" Background="#0D1117" Padding="10,8" CornerRadius="0,0,10,10"
                            BorderBrush="#21262D" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <TextBlock Text="🖥 Удалённая машина" Foreground="#6E7681" FontSize="11" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding ComputerSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ui:ControlHelper.PlaceholderText="Имя или *маска*" Margin="0,0,4,0"/>
                                <Button Grid.Column="1" Content="Поиск" Command="{Binding SearchComputersCommand}"
                                        Padding="8,4"/>
                            </Grid>
                            <ListBox ItemsSource="{Binding RemoteMachines}"
                                     SelectedItem="{Binding SelectedRemoteMachine}"
                                     MaxHeight="100" Margin="0,4,0,0"
                                     Background="Transparent" BorderThickness="0"
                                     Visibility="{Binding RemoteMachines.Count, Converter={StaticResource BoolVis}}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" Foreground="#C9D1D9" FontSize="11" Padding="2"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="#21262D" VerticalAlignment="Stretch"/>

            <!-- ── CENTER: Details + Jobs + Live Log ── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- Printer detail card -->
                    <RowDefinition Height="Auto"/>   <!-- Print jobs -->
                    <RowDefinition Height="*"/>      <!-- Live log -->
                </Grid.RowDefinitions>

                <!-- Printer Details Card -->
                <Border Grid.Row="0" Style="{StaticResource CardPanel}">
                    <Grid>
                        <StackPanel Visibility="{Binding SelectedPrinter, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding SelectedPrinter.Name}" FontSize="16" FontWeight="Bold"
                                       Foreground="#E6EDF3"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Статус" Foreground="#6E7681" FontSize="11"/>
                                    <TextBlock Text="{Binding SelectedPrinter.StatusDisplay}"
                                               Foreground="{Binding SelectedPrinter.Status, Converter={StaticResource StatusColor}}"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Порт" Foreground="#6E7681" FontSize="11"/>
                                    <TextBlock Text="{Binding SelectedPrinter.PortName}" Foreground="#C9D1D9"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Заданий в очереди" Foreground="#6E7681" FontSize="11"/>
                                    <TextBlock Text="{Binding SelectedPrinter.JobCount}" Foreground="#C9D1D9"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Драйвер" Foreground="#6E7681" FontSize="11"/>
                                    <TextBlock Text="{Binding SelectedPrinter.DriverName}" Foreground="#C9D1D9" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Расположение" Foreground="#6E7681" FontSize="11"/>
                                    <TextBlock Text="{Binding SelectedPrinter.Location}" Foreground="#C9D1D9"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <TextBlock Text="← Выберите принтер из списка слева"
                                   Foreground="#484F58" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Visibility="{Binding SelectedPrinter, Converter={StaticResource InvBoolVis}}"/>
                    </Grid>
                </Border>

                <!-- Print Jobs -->
                <Border Grid.Row="1" Style="{StaticResource CardPanel}"
                        Visibility="{Binding PrintJobs.Count, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <TextBlock Text="📋 Очередь печати" FontWeight="SemiBold" Foreground="#E6EDF3" Margin="0,0,0,6"/>
                        <DataGrid ItemsSource="{Binding PrintJobs}" AutoGenerateColumns="False"
                                  IsReadOnly="True" Background="Transparent" RowBackground="#1C2433"
                                  AlternatingRowBackground="#161B22" GridLinesVisibility="None"
                                  HeadersVisibility="Column" MaxHeight="120"
                                  CanUserSortColumns="True">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#0D1117"/>
                                    <Setter Property="Foreground" Value="#6E7681"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Padding" Value="8,4"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding JobId}" Width="50"/>
                                <DataGridTextColumn Header="Документ" Binding="{Binding Document}" Width="*"/>
                                <DataGridTextColumn Header="Владелец" Binding="{Binding Owner}" Width="120"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="90"/>
                                <DataGridTextColumn Header="Страниц" Binding="{Binding TotalPages}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Live Log -->
                <Border Grid.Row="2" Style="{StaticResource CardPanel}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#161B22" Padding="12,8" CornerRadius="10,10,0,0">
                            <Grid>
                                <TextBlock Text="📟 Лог выполнения" FontWeight="SemiBold" Foreground="#E6EDF3"/>
                                <Button Content="Очистить" HorizontalAlignment="Right"
                                        Padding="8,3" FontSize="11"
                                        Click="ClearLog_Click"/>
                            </Grid>
                        </Border>
                        <ListBox Grid.Row="1" x:Name="LogListBox" ItemsSource="{Binding LiveLog}"
                                 Background="#0D1117" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="10,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="55"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TimeStr}" Foreground="#484F58" FontSize="10" FontFamily="Consolas" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Message}"
                                                   Foreground="{Binding Level, Converter={StaticResource LogColor}}"
                                                   FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Center" Background="#21262D" VerticalAlignment="Stretch"/>

            <!-- ── RIGHT PANEL: Fixers ── -->
            <Border Grid.Column="4" Style="{StaticResource CardPanel}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="#161B22" Padding="12,10" CornerRadius="10,10,0,0">
                        <TextBlock Text="🔧 Доступные исправления" FontWeight="SemiBold" Foreground="#E6EDF3"/>
                    </Border>

                    <!-- Fixer list -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding AvailableFixers}"
                             SelectedItem="{Binding SelectedFixer}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Margin="6">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,3"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bdr" Padding="12,9" CornerRadius="8"
                                                    Background="#1C2433" BorderThickness="1" BorderBrush="Transparent"
                                                    Cursor="Hand">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bdr" Property="BorderBrush" Value="#2D7FF9"/>
                                                    <Setter TargetName="Bdr" Property="Background" Value="#0D2137"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bdr" Property="Background" Value="#1E2D40"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               Foreground="#C9D1D9" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Description}" Foreground="#6E7681"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <ItemsControl ItemsSource="{Binding TargetErrorCodes}" Margin="0,5,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#0D2137" CornerRadius="3"
                                                        Padding="5,2" Margin="0,0,4,2">
                                                    <TextBlock Text="{Binding}" Foreground="#58A6FF"
                                                               FontSize="10" FontFamily="Consolas"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Apply / Cancel buttons -->
                    <Border Grid.Row="2" Background="#0D1117" Padding="12,10" CornerRadius="0,0,10,10"
                            BorderBrush="#21262D" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <!-- Progress bar during fix -->
                            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8"
                                         Visibility="{Binding IsFixRunning, Converter={StaticResource BoolVis}}"
                                         Foreground="#2D7FF9"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="▶ Применить исправление"
                                        Command="{Binding ApplyFixCommand}"
                                        Background="#1A3A5C" Foreground="#58A6FF"
                                        BorderBrush="#2D7FF9" BorderThickness="1"
                                        Padding="14,9" FontWeight="SemiBold" Margin="0,0,6,0"
                                        Cursor="Hand"/>
                                <Button Grid.Column="1" Content="✕"
                                        Command="{Binding CancelFixCommand}"
                                        Visibility="{Binding IsFixRunning, Converter={StaticResource BoolVis}}"
                                        Background="#3A1A1A" Foreground="#FF4757"
                                        BorderBrush="#FF4757" BorderThickness="1"
                                        Padding="10,9" Cursor="Hand"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== STATUS BAR ===== -->
        <Border Grid.Row="2" Background="#161B22" Padding="12,0" BorderBrush="#21262D" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="#6E7681" VerticalAlignment="Center" FontSize="12"/>
                <TextBlock Grid.Column="1" Text="© OneDeadMachine · v3.1 beta" Foreground="#30363D" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Source={x:Static sys:Environment.MachineName}, StringFormat='Машина: {0}'}"
                               Foreground="#484F58" FontSize="11" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding Source={x:Static sys:Environment.UserName}, StringFormat='Пользователь: {0}'}"
                               Foreground="#484F58" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Loading overlay -->
        <Grid Grid.Row="1" Background="#80000000"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ui:ProgressRing IsActive="True" Width="40" Height="40" Foreground="#2D7FF9"/>
                <TextBlock Text="Загрузка..." Foreground="#E6EDF3" FontSize="14" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
