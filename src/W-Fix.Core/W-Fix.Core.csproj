<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>

    <!-- Metadata -->
    <Version>3.1.0-beta.1</Version>
    <Authors>OneDeadMachine</Authors>
    <Company>OneDeadMachine</Company>
    <Product>W-Fix Core</Product>
    <Description>Ядро диагностики и исправления принтеров</Description>
    <Copyright>© 2026 OneDeadMachine</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.1.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.4.18" />
    <!-- Explicitly pin the patched .NET 8 line; older PowerShell SDKs pulled vulnerable 8.0.2 transitively. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="8.0.4" />
  </ItemGroup>

  <!-- Windows-specific AD / WMI — NuGet packages (required for single-file publish) -->
  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.DirectoryServices" Version="8.0.0" />
    <PackageReference Include="System.DirectoryServices.AccountManagement" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Catalog\known-issues.json" LogicalName="WFix.Core.Catalog.known-issues.json" />
  </ItemGroup>

</Project>
